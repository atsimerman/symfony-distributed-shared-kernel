{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lab.local/contracts/events/payment.completed.v1.json",
    "title": "PaymentCompletedPayload",
    "description": "Payload of the payment.completed event (routing key payment.completed), wrapped in envelope.v1.json. Published by Payment when the simulated provider settled an order's payment; consumed by Ordering (saga: completes the order).",
    "type": "object",
    "required": ["paymentId", "orderId", "amount"],
    "additionalProperties": false,
    "$defs": {
        "money": {
            "type": "object",
            "required": ["amount", "currency"],
            "additionalProperties": false,
            "properties": {
                "amount": {
                    "type": "integer",
                    "description": "Minor units (e.g. cents)"
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                }
            }
        }
    },
    "properties": {
        "paymentId": {
            "type": "string",
            "format": "uuid"
        },
        "orderId": {
            "type": "string",
            "format": "uuid"
        },
        "amount": { "$ref": "#/$defs/money" }
    }
}
